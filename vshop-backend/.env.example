# Copy this file to .env and fill in your values.
# .env is in .gitignore: never commit real keys.

# ---- Database ----
DB_URL=jdbc:postgresql://localhost:5433/vshop
DB_USERNAME=vshop
DB_PASSWORD=vshop

# ---- JWT (at least 32 random characters, e.g. openssl rand -base64 48) ----
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Access token lifetime in minutes (the app refreshes it on 401)
JWT_ACCESS_EXPIRY_MIN=15
# Refresh token lifetime in days (a new one is issued on every refresh)
JWT_REFRESH_EXPIRY_DAYS=30

# ---- ABA PayWay ----
# true  = fake PayWay (no keys needed). Approve with POST /api/dev/payments/{tranId}/approve
# false = real ABA PayWay sandbox
PAYWAY_MOCK=true
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_MERCHANT_ID=ec478904
# The "Public Key" from your sandbox email is the API key used for the HMAC hash.
PAYWAY_API_KEY=paste-your-sandbox-public-key-here
# Public URL of /api/payway/callback, e.g. from ngrok. Leave empty to rely on polling only.
PAYWAY_CALLBACK_URL=
PAYWAY_LIFETIME_MINUTES=15

# ---- Password reset codes ----
# true  = the 6-digit code is printed in the server log (no email needed)
# false = the code is emailed using the MAIL_* settings below
OTP_LOG_ONLY=true
# Code lifetime, wrong tries per code, and new codes per email per hour (more returns 429)
OTP_EXPIRY_MIN=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
# Free test inbox: create a Mailtrap "Email Testing" inbox and copy its SMTP settings.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=VShop <no-reply@vshop.local>

# The RSA keys from ABA are only needed for other PayWay APIs (e.g. payment links, payouts).
# This project doesn't use them yet. Keep them in a safe place, not in this repo.
